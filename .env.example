# Admin panel password (required for live mode)
ADMIN_PASSWORD=change-me
# Optional: separate secret for signing admin sessions (defaults to one derived from ADMIN_PASSWORD)
SESSION_SECRET=
# Storage. On Vercel, add "Upstash for Redis" from the Marketplace; it sets these for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Local development without Redis: keep data in a JSON file instead
# STORE_FILE=.data/store.json
